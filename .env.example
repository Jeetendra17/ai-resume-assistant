# The site works with ZERO keys -- the assistant then answers extractively from the
# local resume index. Add any one key below to switch on real generation.
# Providers are tried free-first, in this order:
#   groq -> gemini -> cerebras -> openrouter -> mistral -> together -> ollama -> anthropic -> openai

# --- Free tiers (pick one, or several for automatic failover) ---
# https://console.groq.com/keys           fastest free option
GROQ_API_KEY=
# https://aistudio.google.com/apikey      generous free tier
GEMINI_API_KEY=
# https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# https://openrouter.ai/keys              many ":free" open-weight models
OPENROUTER_API_KEY=
# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=

# --- Fully local, fully free (dev only) ---
# USE_OLLAMA=1
# OLLAMA_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1:8b

# --- Paid ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Optional overrides ---
# Pin one provider, or set a custom preference order:
# LLM_PROVIDER=groq
# LLM_PROVIDER=groq,gemini,openrouter
# Override the model for any provider with <NAME>_MODEL:
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.0-flash
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

ASSISTANT_MAX_TOKENS=800
CHAT_RATE_LIMIT=20
LLM_TIMEOUT=45
FLASK_DEBUG=1
